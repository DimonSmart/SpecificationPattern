<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>4.0.0</Version>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Specifications for Entity Framework Core</Title>
		<Description>Immutable, composable specifications for Entity Framework Core, with filtering, ordering, projections, keyset pagination, typed Include/ThenInclude and EF Core query options.</Description>
		<Copyright>DimonSmart</Copyright>
		<PackageProjectUrl>https://github.com/DimonSmart/SpecificationPattern</PackageProjectUrl>
		<PackageIcon>EFCoreSpecification.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/DimonSmart/SpecificationPattern</RepositoryUrl>
		<PackageTags>Specification;Entity Framework Core;EF Core;IQueryable</PackageTags>
		<PackageLicenseExpression>0BSD</PackageLicenseExpression>


		<PackageReleaseNotes>4.0.0: Removed the legacy SpecificationData diagnostic API. Use PipelineSteps for query operations and EFCoreSpecificationData for EF-specific options. See docs/Migration-to-v4.md.</PackageReleaseNotes>


	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DimonSmart.Specification\DimonSmart.Specification.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="EFCoreSpecification.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>